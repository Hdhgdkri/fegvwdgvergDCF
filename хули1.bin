@router.message(Command("admin"))
async def admin(msg: Message):
    if is_admin(msg.from_user.id):
        state_text = "🟢 Работает" if is_work() else "🔴 Остановлен"
        await msg.answer(
            f"{E_GEAR} Админ-панель, блядь\n\n"
            f"➖➖➖➖➖➖➖➖➖➖\n"
            f"{E_GEAR} Состояние: {state_text}\n"
            f"➖➖➖➖➖➖➖➖➖➖",
            reply_markup=admin_menu(),
            parse_mode=PARSE,
        )

@router.message(Command("astats"))
async def admin_stats(msg: Message):
    if not is_admin(msg.from_user.id):
        return
    users_total = cur.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    users_access = cur.execute("SELECT COUNT(*) FROM users WHERE has_access=1").fetchone()[0]
    users_banned = cur.execute("SELECT COUNT(*) FROM bans").fetchone()[0]
    groups_total = cur.execute("SELECT COUNT(*) FROM groups").fetchone()[0]
    scans_total = cur.execute("SELECT COUNT(*) FROM scans").fetchone()[0]
    scans_success = cur.execute("SELECT COUNT(*) FROM scans WHERE status='success'").fetchone()[0]
    scans_failed = cur.execute("SELECT COUNT(*) FROM scans WHERE status='failed'").fetchone()[0]
    scans_pending = cur.execute("SELECT COUNT(*) FROM scans WHERE status='pending'").fetchone()[0]
    deposits = cur.execute("SELECT COALESCE(SUM(total),0) FROM purchases WHERE product LIKE 'Пополнение%'").fetchone()[0]
    purchases = cur.execute("SELECT COALESCE(SUM(total),0) FROM purchases WHERE product='Сканы'").fetchone()[0]
    await msg.answer(
        f"{E_GEAR} Стата админа\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"👥 Пользователи\n"
        f"  Всего: {users_total}\n"
        f"  С доступом: {users_access}\n"
        f"  Забанено: {users_banned}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"👥 Группы: {groups_total}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"📸 Сканы\n"
        f"  Всего: {scans_total}\n"
        f"  {E_OK} Успешных: {scans_success}\n"
        f"  {E_FAIL} Отклонённых: {scans_failed}\n"
        f"  {E_HOUR} В ожидании: {scans_pending}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_MONEY} Пополнений: {deposits:.2f} $\n"
        f"{E_CART} Покупок сканов: {purchases:.2f} $",
        parse_mode=PARSE,
    )

@router.callback_query(F.data == "adm_stats")
async def cb_admin_stats(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return
    await admin_stats(cb.message)

@router.callback_query(F.data == "adm_toggle")
async def adm_toggle(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return
    new_state = not is_work()
    set_work(new_state)
    await cb.message.edit_reply_markup(reply_markup=admin_menu())
    if new_state:
        await cb.answer("🟢 Бот работает, ёпта. Принимает фото.", show_alert=True)
    else:
        await cb.answer("🔴 Бот остановлен, хули. Фото не принимаются.", show_alert=True)

@router.callback_query(F.data == "adm_access")
async def adm_access(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return
    await state.set_state(AdminState.give_access)
    await cb.message.answer(f"{E_OK} Выдать доступ, блядь\n\n{E_NOTE} Отправь ID пользователя:", parse_mode=PARSE)

@router.message(AdminState.give_access)
async def do_access(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    try:
        uid = int(msg.text)
    except ValueError:
        await msg.answer(f"{E_FAIL} ID должен быть числом, дебил.", parse_mode=PARSE)
        return
    ensure_user(uid)
    cur.execute("UPDATE users SET has_access=1 WHERE user_id=?", (uid,))
    db.commit()
    await state.clear()
    await msg.answer(f"{E_OK} Доступ выдан, заебись\n\n{E_PROFILE} ID: {uid}", parse_mode=PARSE)

@router.callback_query(F.data == "adm_scans")
async def adm_scans(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return
    await state.set_state(AdminState.add_scans)
    await cb.message.answer(f"{E_PLUS} Выдать сканы, хули\n\nФормат: ID количество\nПример: 123456789 50", parse_mode=PARSE)

@router.message(AdminState.add_scans)
async def do_scans(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    try:
        uid, qty = msg.text.split()
        uid, qty = int(uid), int(qty)
    except Exception:
        await msg.answer(f"{E_FAIL} Формат: ID количество, не тупи.", parse_mode=PARSE)
        return
    ensure_user(uid)
    change_scans(uid, qty)
    await state.clear()
    await msg.answer(
        f"{E_OK} Сканы начислены, ёбана\n\n{E_PROFILE} ID: {uid}\n{E_PLUS} Добавлено: {qty}\n{E_PACK} Всего: {get_scans(uid)}",
        parse_mode=PARSE,
    )

