bot = Bot(BOT_TOKEN)
dp = Dispatcher(storage=MemoryStorage())
router = Router()
dp.include_router(router)

crypto = None
xr_session = None
XR_BASE = "https://pay.api.xrocket.exchange"

async def check_sub(uid):
    try:
        member = await bot.get_chat_member(CHANNEL_ID, uid)
        return member.status not in ("left", "kicked")
    except Exception:
        return True

async def xr_create_invoice(amount_usd, client_id, description):
    async with xr_session.post(
        f"{XR_BASE}/api/v1/invoices",
        headers={"Authorization": f"Bearer {XROCKET_TOKEN}", "Accept": "application/json"},
        json={
            "priceCurrency": "USDT",
            "priceAmount": f"{amount_usd:.2f}",
            "clientInvoiceId": client_id,
            "description": description,
            "expiresIn": 30 * 60 * 1000,
        },
    ) as resp:
        data = await resp.json(content_type=None)
        if resp.status >= 400:
            raise Exception(f"xRocket: {data}")
        return data

async def xr_get_invoice_status(invoice_id):
    async with xr_session.get(
        f"{XR_BASE}/api/v1/invoice",
        headers={"Authorization": f"Bearer {XROCKET_TOKEN}", "Accept": "application/json"},
        params={"invoiceId": invoice_id},
    ) as resp:
        if resp.status >= 400:
            return None
        data = await resp.json(content_type=None)
        return data.get("status") if isinstance(data, dict) else None

# ---------- /start ----------
@router.message(CommandStart())
async def start(msg: Message, state: FSMContext):
    await state.clear()
    uid = msg.from_user.id
    ensure_user(uid, msg.from_user.username)

    if is_banned(uid):
        reason = cur.execute("SELECT reason FROM bans WHERE user_id=?", (uid,)).fetchone()
        await msg.answer(
            f"{E_BAN} Ты забанен, хули.\n\nПричина: {reason['reason'] or 'не указана'}",
            parse_mode=PARSE,
        )
        return

    if msg.chat.type in ("group", "supergroup"):
        owner_id = get_group_owner(msg.chat.id)
        if owner_id:
            await msg.answer(
                f"{E_OK} Группа активна, всё заебись.\n\n"
                f"{E_CROWN} Владелец: {owner_id}\n"
                f"{E_PACK} Остаток сканов: {get_scans(owner_id)}\n\n"
                f"Кидайте фото, хули стоите.",
                parse_mode=PARSE,
            )
        else:
            await msg.answer(
                f"{E_WARN} Группа не активирована, блядь.\n\n"
                f"Владелец сканов должен написать /add в этой группе.",
                parse_mode=PARSE,
            )
        return

    if not await check_sub(uid):
        await msg.answer(
            f"{E_LOCK} Сначала подпишись на канал, потом пользуйся.",
            reply_markup=sub_kb(),
            parse_mode=PARSE,
        )
        return

    if not has_access(uid):
        await msg.answer(
            f"{E_STOP} Хуй тебе, а не доступ.\n\n"
            f"Бот работает по приглашению.\n"
            f"Напиши админу: {ADMIN_CONTACT}",
            parse_mode=PARSE,
        )
        return

    await msg.answer(
        f"{E_HELLO} Здарова, хули надо?\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_MONEY} Баланс: {get_balance(uid):.2f} $\n"
        f"{E_PACK} Сканов: {get_scans(uid)}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n\n"
        f"{E_CASH} 1 скан — {PRICE_PER_SCAN:.2f} $\n"
        f"{E_DOWN} Минимум — {MIN_PURCHASE} сканов\n\n"
        f"Выбирай, хули.",
        reply_markup=main_menu(),
        parse_mode=PARSE,
    )

@router.callback_query(F.data == "check_sub")
async def cb_check_sub(cb: CallbackQuery):
    if await check_sub(cb.from_user.id):
        await cb.message.edit_text(
            f"{E_OK} Подписка подтверждена, заебись.\n\nНапиши /start.",
            parse_mode=PARSE,
        )
    else:
        await cb.answer("Хуй там, ты не подписан.", show_alert=True)

# ---------- /add ----------
@router.message(Command("add"))
async def add_group(msg: Message):
    if msg.chat.type not in ("group", "supergroup"):
        await msg.answer(f"{E_Q} Хули ты тут делаешь? Команда только для групп.", parse_mode=PARSE)
        return
    uid = msg.from_user.id
    if not has_access(uid):
        await msg.answer(f"{E_LOCK} Хуй, а не доступ. Напиши: {ADMIN_CONTACT}", parse_mode=PARSE)
        return
    if get_scans(uid) <= 0:
        await msg.answer(f"{E_WARN} Сканов ноль, хули ты хотел?\n\nКупи в ЛС бота.", parse_mode=PARSE)
        return
    existing = get_group_owner(msg.chat.id)
    if existing and existing != uid:
        await msg.answer(f"{E_WARN} Эта группа уже привязана к другому, иди нахуй.", parse_mode=PARSE)
        return
    cur.execute("INSERT OR REPLACE INTO groups (group_id, owner_id, title) VALUES (?, ?, ?)",
                (msg.chat.id, uid, msg.chat.title))
    db.commit()
    await msg.answer(
        f"{E_OK} Группа подключена, ёпта.\n\n"
        f"{E_CROWN} Владелец: ты\n"
        f"{E_PACK} Сканов: {get_scans(uid)}\n\n"
        f"Участники могут отправлять фото.",
        parse_mode=PARSE,
    )

# ---------- /owner ----------
@router.message(Command("owner"))
async def change_owner(msg: Message):
    if msg.chat.type not in ("group", "supergroup"):
        await msg.answer(f"{E_Q} Только в группах, хули.", parse_mode=PARSE)
        return
    if not msg.reply_to_message or not msg.reply_to_message.from_user:
        await msg.answer(f"{E_WARN} Ответь на сообщение нового владельца командой /owner", parse_mode=PARSE)
        return

    current_owner = get_group_owner(msg.chat.id)
    uid = msg.from_user.id
    new_owner = msg.reply_to_message.from_user.id

    if uid != current_owner and not is_admin(uid):
        await msg.answer(f"{E_LOCK} Хуй, а не смена владельца.", parse_mode=PARSE)
        return
    if new_owner == current_owner:
        await msg.answer(f"{E_INFO} Он и так владелец, хули.", parse_mode=PARSE)
        return
    if not has_access(new_owner):
        await msg.answer(f"{E_FAIL} У него нет доступа к боту.", parse_mode=PARSE)
        return
    if get_scans(new_owner) <= 0:
        await msg.answer(f"{E_FAIL} У него нет сканов, хули.", parse_mode=PARSE)
        return

    # Удаляем прошлый запрос, если был
    cur.execute("DELETE FROM owner_requests WHERE group_id=?", (msg.chat.id,))
    cur.execute(
        "INSERT INTO owner_requests (group_id, from_user, to_user, created_at) VALUES (?, ?, ?, ?)",
        (msg.chat.id, uid, new_owner, datetime.utcnow().timestamp()),
    )
    db.commit()

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="✅ Стать владельцем", callback_data=f"owner_accept_{msg.chat.id}"),
        InlineKeyboardButton(text="❌ Отказаться", callback_data=f"owner_decline_{msg.chat.id}"),
    ]])
    try:
        await bot.send_message(
            new_owner,
            f"{E_CROWN} Тебе предлагают стать владельцем группы «{msg.chat.title}».\n\n"
            f"Сканы будут списываться с твоего баланса при каждом фото в группе.\n\n"
            f"Принять? (действует 10 минут)",
            reply_markup=kb,
            parse_mode=PARSE,
        )
        await msg.answer(
            f"{E_OK} Запрос отправлен пользователю {new_owner}.\n\n"
            f"Ждём, пока он подтвердит.",
            parse_mode=PARSE,
        )
    except Exception:
        await msg.answer(
            f"{E_FAIL} Не удалось отправить запрос. Возможно, он не писал боту в ЛС.",
            parse_mode=PARSE,
        )

@router.callback_query(F.data.startswith("owner_accept_"))
async def owner_accept(cb: CallbackQuery):
    group_id = int(cb.data.split("_")[2])
    uid = cb.from_user.id

    req = cur.execute("SELECT * FROM owner_requests WHERE group_id=?", (group_id,)).fetchone()
    if not req or req["to_user"] != uid:
        await cb.answer("Этот запрос не для тебя или уже неактуален.", show_alert=True)
        return

    if datetime.utcnow().timestamp() - req["created_at"] > OWNER_REQUEST_TTL:
        cur.execute("DELETE FROM owner_requests WHERE group_id=?", (group_id,))
        db.commit()
        await cb.message.edit_text(f"{E_HOUR} Запрос истёк, хули.", parse_mode=PARSE)
        return

    if get_scans(uid) <= 0:
        await cb.answer("У тебя нет сканов, хули.", show_alert=True)
        return

    cur.execute("UPDATE groups SET owner_id=? WHERE group_id=?", (uid, group_id))
    cur.execute("DELETE FROM owner_requests WHERE group_id=?", (group_id,))
    db.commit()

    await cb.message.edit_text(
        f"{E_OK} Ты стал владельцем группы, ёпта.\n\n"
        f"{E_PACK} Сканов у тебя: {get_scans(uid)}\n\n"
        f"Теперь сканы списываются с твоего баланса.",
        parse_mode=PARSE,
    )
    await cb.answer("Ты владелец.")

    try:
        await bot.send_message(
            group_id,
            f"{E_CROWN} Новый владелец группы: {uid}\n"
            f"{E_PACK} Сканов у него: {get_scans(uid)}",
            parse_mode=PARSE,
        )
    except Exception:
        pass

@router.callback_query(F.data.startswith("owner_decline_"))
async def owner_decline(cb: CallbackQuery):
    group_id = int(cb.data.split("_")[2])
    uid = cb.from_user.id

    req = cur.execute("SELECT * FROM owner_requests WHERE group_id=?", (group_id,)).fetchone()
    if not req or req["to_user"] != uid:
        await cb.answer("Этот запрос не для тебя или уже неактуален.", show_alert=True)
        return

    cur.execute("DELETE FROM owner_requests WHERE group_id=?", (group_id,))
    db.commit()

    await cb.message.edit_text(
        f"{E_INFO} Ты отказался стать владельцем группы.",
        parse_mode=PARSE,
    )
    await cb.answer("Отказ принят.")

    try:
        await bot.send_message(
            group_id,
            f"{E_INFO} Пользователь {uid} отказался стать владельцем.",
            parse_mode=PARSE,
        )
    except Exception:
        pass

# ---------- /gstats ----------
@router.message(Command("gstats"))
async def group_stats(msg: Message):
    if msg.chat.type not in ("group", "supergroup"):
        await msg.answer(f"{E_Q} Только в группах.", parse_mode=PARSE)
        return
    owner_id = get_group_owner(msg.chat.id)
    if not owner_id:
        await msg.answer(f"{E_WARN} Группа не привязана, хули.", parse_mode=PARSE)
        return
    total = cur.execute("SELECT COUNT(*) FROM scans WHERE group_id=?", (msg.chat.id,)).fetchone()[0]
    success = cur.execute("SELECT COUNT(*) FROM scans WHERE group_id=? AND status='success'", (msg.chat.id,)).fetchone()[0]
    failed = cur.execute("SELECT COUNT(*) FROM scans WHERE group_id=? AND status='failed'", (msg.chat.id,)).fetchone()[0]
    pending = cur.execute("SELECT COUNT(*) FROM scans WHERE group_id=? AND status='pending'", (msg.chat.id,)).fetchone()[0]
    top = cur.execute(
        "SELECT user_id, COUNT(*) as cnt FROM scans WHERE group_id=? GROUP BY user_id ORDER BY cnt DESC LIMIT 5",
        (msg.chat.id,),
    ).fetchall()
    top_lines = "\n".join(f"  {i+1}. {r['user_id']} — {r['cnt']}" for i, r in enumerate(top)) or "  нет"
    await msg.answer(
        f"{E_STATS} Статистика группы\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_CROWN} Владелец: {owner_id}\n"
        f"{E_PACK} Сканов у владельца: {get_scans(owner_id)}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"📸 Всего сканов: {total}\n"
        f"{E_OK} Успешных: {success}\n"
        f"{E_FAIL} Отклонённых: {failed}\n"
        f"{E_HOUR} В ожидании: {pending}\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"👥 Топ отправителей:\n{top_lines}",
        parse_mode=PARSE,
    )

