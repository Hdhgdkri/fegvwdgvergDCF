# ================== БД ==================
db = sqlite3.connect(DB_PATH)
db.row_factory = sqlite3.Row
cur = db.cursor()

cur.executescript("""
CREATE TABLE IF NOT EXISTS users (
    user_id     INTEGER PRIMARY KEY,
    username    TEXT,
    balance     REAL DEFAULT 0,
    scans       INTEGER DEFAULT 0,
    has_access  INTEGER DEFAULT 0,
    is_admin    INTEGER DEFAULT 0
);
CREATE TABLE IF NOT EXISTS groups (
    group_id    INTEGER PRIMARY KEY,
    owner_id    INTEGER,
    title       TEXT
);
CREATE TABLE IF NOT EXISTS scans (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id     INTEGER,
    group_id    INTEGER,
    file_id     TEXT,
    status      TEXT DEFAULT 'pending',
    admin_msg_id INTEGER,
    created_at  TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS purchases (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id     INTEGER,
    product     TEXT,
    qty         INTEGER,
    code        TEXT UNIQUE,
    total       REAL,
    date        TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    val TEXT
);
CREATE TABLE IF NOT EXISTS bans (
    user_id INTEGER PRIMARY KEY,
    reason TEXT,
    banned_at TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS promos (
    code TEXT PRIMARY KEY,
    amount REAL DEFAULT 0,
    scans INTEGER DEFAULT 0,
    uses INTEGER DEFAULT 0,
    max_uses INTEGER DEFAULT 1,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS promo_uses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    code TEXT,
    user_id INTEGER,
    used_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(code, user_id)
);
CREATE TABLE IF NOT EXISTS owner_requests (
    group_id    INTEGER PRIMARY KEY,
    from_user   INTEGER,
    to_user     INTEGER,
    created_at  REAL
);
""")
db.commit()

try:
    cur.execute("ALTER TABLE users ADD COLUMN balance REAL DEFAULT 0")
    db.commit()
except sqlite3.OperationalError:
    pass

cur.execute("INSERT OR IGNORE INTO users (user_id, is_admin, has_access) VALUES (?, 1, 1)", (SUPER_ADMIN_ID,))
if not cur.execute("SELECT val FROM settings WHERE key='work'").fetchone():
    cur.execute("INSERT INTO settings (key, val) VALUES ('work', '1')")
db.commit()


def get_user(uid):
    return cur.execute("SELECT * FROM users WHERE user_id=?", (uid,)).fetchone()

def ensure_user(uid, username=None):
    if not get_user(uid):
        cur.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (uid, username))
        db.commit()

def is_admin(uid):
    u = get_user(uid); return bool(u and u["is_admin"])

def has_access(uid):
    u = get_user(uid); return bool(u and (u["has_access"] or u["is_admin"]))

def get_balance(uid):
    r = cur.execute("SELECT balance FROM users WHERE user_id=?", (uid,)).fetchone()
    return r["balance"] if r else 0.0

def change_balance(uid, delta):
    cur.execute("UPDATE users SET balance = balance + ? WHERE user_id=?", (delta, uid))
    db.commit()

def get_scans(uid):
    r = cur.execute("SELECT scans FROM users WHERE user_id=?", (uid,)).fetchone()
    return r["scans"] if r else 0

def change_scans(uid, delta):
    cur.execute("UPDATE users SET scans = scans + ? WHERE user_id=?", (delta, uid))
    db.commit()

def get_group_owner(gid):
    r = cur.execute("SELECT owner_id FROM groups WHERE group_id=?", (gid,)).fetchone()
    return r["owner_id"] if r else None

def all_admins():
    return [r["user_id"] for r in cur.execute("SELECT user_id FROM users WHERE is_admin=1").fetchall()]

def is_work():
    r = cur.execute("SELECT val FROM settings WHERE key='work'").fetchone()
    return r["val"] == "1" if r else True

def set_work(state):
    cur.execute("INSERT OR REPLACE INTO settings (key, val) VALUES ('work', ?)", ("1" if state else "0",))
    db.commit()

def is_banned(uid):
    return cur.execute("SELECT 1 FROM bans WHERE user_id=?", (uid,)).fetchone() is not None

def ban_user(uid, reason=""):
    cur.execute("INSERT OR REPLACE INTO bans (user_id, reason) VALUES (?, ?)", (uid, reason))
    db.commit()

def unban_user(uid):
    cur.execute("DELETE FROM bans WHERE user_id=?", (uid,))
    db.commit()

def get_promo(code):
    return cur.execute("SELECT * FROM promos WHERE code=?", (code,)).fetchone()

def promo_used_by(code, uid):
    return cur.execute("SELECT 1 FROM promo_uses WHERE code=? AND user_id=?", (code, uid)).fetchone() is not None

def use_promo(code, uid):
    p = get_promo(code)
    if not p:
        return False, "Промокод не найден, хули."
    if promo_used_by(code, uid):
        return False, "Ты уже использовал этот промокод."
    if p["uses"] >= p["max_uses"]:
        return False, "Промокод закончился, хули."
    cur.execute("UPDATE promos SET uses = uses + 1 WHERE code=?", (code,))
    cur.execute("INSERT INTO promo_uses (code, user_id) VALUES (?, ?)", (code, uid))
    if p["amount"] > 0:
        change_balance(uid, p["amount"])
    if p["scans"] > 0:
        change_scans(uid, p["scans"])
    db.commit()
    parts = []
    if p["amount"] > 0:
        parts.append(f"+{p['amount']:.2f} $")
    if p["scans"] > 0:
        parts.append(f"+{p['scans']} сканов")
    return True, ", ".join(parts)

def create_promo(code, amount=0, scans=0, max_uses=1):
    cur.execute(
        "INSERT OR REPLACE INTO promos (code, amount, scans, max_uses) VALUES (?, ?, ?, ?)",
        (code, amount, scans, max_uses),
    )
    db.commit()

# ================== СОСТОЯНИЯ ==================
class TopupState(StatesGroup):
    waiting_amount = State()

class BuyState(StatesGroup):
    qty = State()

class PasswordState(StatesGroup):
    waiting = State()

class PromoState(StatesGroup):
    waiting = State()

class AdminState(StatesGroup):
    give_access = State()
    add_scans = State()
    broadcast = State()
    ban = State()
    unban = State()
    promo = State()

