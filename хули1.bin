        return
    await state.set_state(AdminState.ban)
    await cb.message.answer(f"{E_BAN} Забанить, хули\n\nФормат: ID причина\nПример: 123456789 спам", parse_mode=PARSE)

@router.message(AdminState.ban)
async def do_ban(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    parts = msg.text.split(maxsplit=1)
    try:
        uid = int(parts[0])
        reason = parts[1] if len(parts) > 1 else "не указана"
    except (ValueError, IndexError):
        await msg.answer(f"{E_FAIL} Формат: ID причина", parse_mode=PARSE)
        return
    ban_user(uid, reason)
    await state.clear()
    await msg.answer(f"{E_OK} {uid} забанен, хули\nПричина: {reason}", parse_mode=PARSE)

