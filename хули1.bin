@router.callback_query(F.data.startswith("check_xrocket_"))
async def cb_check_xrocket(cb: CallbackQuery):
    parts = cb.data.split("_")
    inv_id = parts[2]
    amount = float(parts[3])
    try:
        status = await xr_get_invoice_status(inv_id)
        if status == "paid":
            exists = cur.execute("SELECT 1 FROM purchases WHERE code=?", (f"xrocket_{inv_id}",)).fetchone()
            if exists:
                await cb.answer("Этот счёт уже зачислен, хули ты жмёшь.", show_alert=True)
                return
            change_balance(cb.from_user.id, amount)
            cur.execute("INSERT INTO purchases (user_id, product, qty, code, total) VALUES (?,?,?,?,?)",
                        (cb.from_user.id, "Пополнение xRocket", 1, f"xrocket_{inv_id}", amount))
            db.commit()
            await cb.message.edit_text(
                f"{E_OK} Баланс пополнен, заебись\n\n"
                f"{E_MONEY} Зачислено: {amount:.2f} $\n"
                f"{E_MONEY} Новый баланс: {get_balance(cb.from_user.id):.2f} $",
                parse_mode=PARSE,
            )
        elif status in ("expired", "cancelled"):
            await cb.answer("Счёт сдох, создай новый.", show_alert=True)
        elif status == "partially_paid":
            await cb.answer("Оплатил не до конца, хули. Пиши в поддержку.", show_alert=True)
        else:
            await cb.answer("Оплата не поступила, хули. Попробуй через минуту.", show_alert=True)
    except Exception as ex:
        await cb.answer(f"Ошибка проверки: {ex}", show_alert=True)

