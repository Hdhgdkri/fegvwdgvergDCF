@router.message(TopupState.waiting_amount)
async def topup_amount(msg: Message, state: FSMContext):
    if msg.chat.type != "private":
        return
    try:
        amount = float(msg.text.replace(",", "."))
        if amount < 1:
            await msg.answer(f"{E_FAIL} Хуйня какая-то. Минимум — 1.00 $.", parse_mode=PARSE)
            return
    except ValueError:
        await msg.answer(f"{E_FAIL} Ты дебил? Введи число, например: 10 или 25.50", parse_mode=PARSE)
        return
    await state.clear()
    await msg.answer(
        f"{E_MONEY2} Пополнение на {amount:.2f} $\n\nВыбери, хули:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🪙 CryptoBot", callback_data=f"topup_crypto_{amount}")],
            [InlineKeyboardButton(text="🚀 xRocket", callback_data=f"topup_xrocket_{amount}")],
        ]),
        parse_mode=PARSE,
    )

