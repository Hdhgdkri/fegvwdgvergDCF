@router.callback_query(F.data.startswith("check_crypto_"))
async def cb_check_crypto(cb: CallbackQuery):
    parts = cb.data.split("_")
    inv_id = int(parts[2])
    amount = float(parts[3])
    try:
        inv = await crypto.get_invoices(invoice_ids=inv_id)
        invoice = inv[0] if isinstance(inv, list) else inv
        if invoice.status == "paid":
            exists = cur.execute("SELECT 1 FROM purchases WHERE code=?", (f"crypto_{inv_id}",)).fetchone()
            if exists:
                await cb.answer("Этот счёт уже зачислен, хули ты жмёшь.", show_alert=True)
                return
            change_balance(cb.from_user.id, amount)
            cur.execute("INSERT INTO purchases (user_id, product, qty, code, total) VALUES (?,?,?,?,?)",
                        (cb.from_user.id, "Пополнение CryptoBot", 1, f"crypto_{inv_id}", amount))
            db.commit()
            await cb.message.edit_text(
                f"{E_OK} Баланс пополнен, заебись\n\n"
                f"{E_MONEY} Зачислено: {amount:.2f} $\n"
                f"{E_MONEY} Новый баланс: {get_balance(cb.from_user.id):.2f} $",
                parse_mode=PARSE,
            )
        else:
            await cb.answer("Хуй там, оплата не поступила. Оплати и нажми «Проверить» снова.", show_alert=True)
    except Exception as ex:
        await cb.answer(f"Ошибка: {ex}", show_alert=True)

