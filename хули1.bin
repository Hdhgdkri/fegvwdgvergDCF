@router.callback_query(F.data == "adm_promo")
async def adm_promo(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return
    await state.set_state(AdminState.promo)
    await cb.message.answer(
        f"{E_PARTY} Создать промокод\n\n"
        f"Формат: КОД СУММА СКАНЫ МАКС_ИСПОЛЬЗОВАНИЙ\n"
        f"Пример: WELCOME 5 10 100",
        parse_mode=PARSE,
    )

@router.message(AdminState.promo)
async def do_promo(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    parts = msg.text.split()
    if len(parts) != 4:
        await msg.answer(f"{E_FAIL} Формат: КОД СУММА СКАНЫ МАКС", parse_mode=PARSE)
        return
    code = parts[0].upper()
    try:
        amount = float(parts[1])
        scans = int(parts[2])
        max_uses = int(parts[3])
    except ValueError:
        await msg.answer(f"{E_FAIL} Числа введи, дебил.", parse_mode=PARSE)
        return
    create_promo(code, amount, scans, max_uses)
    await state.clear()
    await msg.answer(
        f"{E_OK} Промокод создан, заебись\n\n"
        f"🎁 Код: {code}\n"
        f"💰 Сумма: {amount} $\n"
        f"📦 Сканы: {scans}\n"
        f"🔢 Макс. использований: {max_uses}",
        parse_mode=PARSE,
    )

@router.callback_query(F.data == "adm_broadcast")
async def adm_broadcast(cb: CallbackQuery, state: FSMContext):
    if not is_admin(cb.from_user.id):
        return
    await state.set_state(AdminState.broadcast)
    await cb.message.answer(f"{E_BELL} Рассылка, блядь\n\n{E_NOTE} Отправь текст сообщения:", parse_mode=PARSE)

@router.message(AdminState.broadcast)
async def do_broadcast(msg: Message, state: FSMContext):
    if not is_admin(msg.from_user.id):
        return
    await state.clear()
    users = cur.execute("SELECT user_id FROM users WHERE has_access=1").fetchall()
    ok = fail = 0
    for u in users:
        try:
            await bot.send_message(u["user_id"], msg.text)
            ok += 1
        except Exception:
            fail += 1
    await msg.answer(
        f"{E_OK} Рассылка завершена, хули\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_MAIL} Доставлено: {ok}\n"
        f"{E_FAIL} Ошибок: {fail}\n"
        f"➖➖➖➖➖➖➖➖➖➖",
        parse_mode=PARSE,
    )

@router.callback_query(F.data == "adm_users")
async def adm_users(cb: CallbackQuery):
    if not is_admin(cb.from_user.id):
        return
    total = cur.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    wa = cur.execute("SELECT COUNT(*) FROM users WHERE has_access=1").fetchone()[0]
    await cb.message.answer(
        f"{E_USERS} Пользователи, ёпта\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"{E_PROFILE} Всего: {total}\n"
        f"{E_OK} С доступом: {wa}\n"
        f"➖➖➖➖➖➖➖➖➖➖",
        parse_mode=PARSE,
    )

# ================== ЗАПУСК ==================
async def main():
    global crypto, xr_session
    crypto = AioCryptoPay(token=CRYPTOBOT_TOKEN)
    xr_session = aiohttp.ClientSession()
    await bot.delete_webhook(drop_pending_updates=True)
    asyncio.create_task(scan_timeout_watcher())
    asyncio.create_task(owner_request_watcher())
    print("Бот запущен")
    try:
        await dp.start_polling(bot)
    finally:
        await xr_session.close()
        await crypto.close()

if __name__ == "__main__":
    asyncio.run(main())